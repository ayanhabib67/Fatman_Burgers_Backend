NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fatman_burgers_pos
# Comma-separated origins, e.g. https://fatman-pos.greenwich.edu.pk
CORS_ORIGIN=https://fatman-pos.greenwich.edu.pk
DEFAULT_OUTLET=fatman
DEV_BARISTA_PIN=1234
DEV_OWNER_PIN=5678
HR_TOKEN_SECRET=change-me-long-random-secret
HR_ADMIN_EMAIL=hr@fatman.local
HR_ADMIN_PASSWORD=admin123

# ---- Cloudinary (till day-close transfer slips) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- ADMS (ZKTeco uFace800 Plus → Hostinger) ----
# Public base URL the DEVICE can reach (HTTP recommended; many ZK units hate HTTPS)
# Examples:
#   ADMS_PUBLIC_URL=http://YOUR_VPS_PUBLIC_IP:8088
#   ADMS_PUBLIC_URL=http://api.yourdomain.com:8088
ADMS_PUBLIC_URL=http://187.52.115.161:8088

# Extra ports that also serve /iclock (comma-separated). Open these in Hostinger firewall.
ADMS_EXTRA_PORTS=8088,86

# On Hostinger ADMS-only production, disable LAN TCP pull:
ZK_PULL_ENABLED=false
